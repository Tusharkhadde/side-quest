# --- Model provider -------------------------------------------------------
# "ollama" (default), "openai" (any OpenAI-compatible server running Gemma), or "mock"
LLM_PROVIDER=ollama

# Ollama (local, default). gemma3n:e4b writes the quests.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e4b
# Ollama's gemma3n build is text-only today, so photo checks use a vision-capable Gemma.
OLLAMA_VISION_MODEL=gemma4:e4b

# OpenAI-compatible server (vLLM / llama.cpp / DigitalOcean GPU Droplet / Gradient)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=google/gemma-3n-E4B-it
LLM_VISION_MODEL=

# Run the whole app with a deterministic mock model (no GPU, no Ollama needed)
DEMO_MODE=0

# Let the Settings page point at a different model endpoint (always on in dev)
ALLOW_MODEL_OVERRIDE=0

# --- Optional voice ---------------------------------------------------------
# If set, Voice mode can use ElevenLabs TTS via /api/tts. Otherwise the free
# on-device Web Speech API is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
