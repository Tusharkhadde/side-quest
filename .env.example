# --- Open models -------------------------------------------------------------
# Tried in this order; if one fails or times out the next one answers.
# Ids: gemma-google, do-gradient, openai, ollama, demo
LLM_PROVIDERS=gemma-google,do-gradient,demo
# Optional: a different order for photo checks (e.g. "do-gradient,gemma-google").
VISION_PROVIDERS=

# 1) Gemma on Google's Gemini API (default). Free key: https://aistudio.google.com/apikey
#    GEMINI_API_KEY also works; GOOGLE_API_KEY wins if both are set.
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_VISION_MODEL defaults to GEMMA_MODEL (Gemma 4 is multimodal).
GEMMA_VISION_MODEL=

# 2) DigitalOcean serverless inference (OpenAI-compatible, https://inference.do-ai.run/v1)
#    Model access key: https://cloud.digitalocean.com/model-studio/manage-keys
DO_MODEL_ACCESS_KEY=
DO_MODEL=gemma-4-31B-it
# Open vision model for photo checks on DigitalOcean; "none" disables vision there.
DO_VISION_MODEL=nemotron-nano-12b-v2-vl

# 3) Any OpenAI-compatible server (OpenRouter, Groq, Hugging Face, vLLM on a GPU Droplet).
#    Add "openai" to LLM_PROVIDERS to use it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=

# 4) Self-host: Ollama on your own machine. Add "ollama" to LLM_PROVIDERS (or set LLM_PROVIDERS=ollama).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e4b
OLLAMA_VISION_MODEL=gemma4:e4b

# Per-provider time budget in ms (repairs included) before falling through.
LLM_TIMEOUT_MS=25000
VISION_TIMEOUT_MS=45000

# 1 = only the built-in demo model (no keys, no network). Handy for screenshots.
DEMO_MODE=0

# --- Optional voice ---------------------------------------------------------
# If set, Voice mode can use ElevenLabs TTS via /api/tts. Otherwise the free
# on-device Web Speech API is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
