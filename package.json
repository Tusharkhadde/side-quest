{
  "name": "side-quest",
  "version": "0.1.0",
  "private": true,
  "description": "An open-model agent (Gemma) that turns a long screen session into a 20-minute outdoor quest.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "demo": "DEMO_MODE=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch:screen": "node watcher/bin/side-quest-watch.js"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
